# Public: Supabase project URL and publishable key only. Never put service credentials here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required for integration secrets, synchronization, and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# 64 hexadecimal characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional: explicit application origin for deployment tooling, never a redirect supplied by a visitor.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:5173
